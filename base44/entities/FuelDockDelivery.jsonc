{
  "name": "FuelDockDelivery",
  "type": "object",
  "properties": {
    "market": {
      "type": "string",
      "enum": [
        "Long Beach",
        "Oakland",
        "Portland",
        "Seattle"
      ],
      "description": "Operating market for this delivery"
    },
    "fuel_dock_location": {
      "type": "string",
      "description": "Fuel dock location (e.g., Seattle Pier 15, Long Beach Dock)"
    },
    "vessel_name": {
      "type": "string",
      "description": "Customer's vessel name"
    },
    "customer": {
      "type": "string",
      "description": "Customer name"
    },
    "cargo_type": {
      "type": "string",
      "description": "Type of cargo being delivered"
    },
    "gallons_delivered": {
      "type": "number",
      "description": "Actual gallons delivered via pipeline"
    },
    "delivery_date": {
      "type": "string",
      "format": "date",
      "description": "Date of fuel dock delivery"
    },
    "requested_delivery_time": {
      "type": "string",
      "description": "Requested delivery time in 24-hour format"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "scheduled",
      "description": "Current delivery status"
    },
    "storage_tank_id": {
      "type": "string",
      "description": "ID of the storage tank supplying this delivery (if applicable)"
    },
    "paperwork_sent_to_billing": {
      "type": "boolean",
      "default": false,
      "description": "Whether paperwork has been sent to billing"
    },
    "sage_order_number": {
      "type": "string",
      "description": "Sage ERP order/delivery ticket number"
    },
    "entered_in_sage": {
      "type": "boolean",
      "default": false,
      "description": "Whether order has been entered in Sage"
    },
    "notes": {
      "type": "string",
      "description": "Additional delivery notes"
    },
    "storage_tank_name": {
      "type": "string",
      "description": "Name of the supplying storage tank for quick reference"
    }
  },
  "required": [
    "market",
    "fuel_dock_location",
    "vessel_name",
    "delivery_date"
  ]
}