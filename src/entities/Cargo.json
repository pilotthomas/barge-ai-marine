{
  "name": "Cargo",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Cargo type name (e.g., Diesel, Gasoline, Jet Fuel)"
    },
    "category": {
      "type": "string",
      "enum": [
        "petroleum",
        "chemical",
        "other"
      ],
      "default": "petroleum",
      "description": "Cargo category"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the cargo type"
    },
    "handling_notes": {
      "type": "string",
      "description": "Special handling requirements or notes"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this cargo type is currently in use"
    }
  },
  "required": [
    "name"
  ]
}